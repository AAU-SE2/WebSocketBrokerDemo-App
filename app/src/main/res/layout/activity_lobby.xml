<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
   >

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        android:src="@drawable/lobby"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0" />


    <Button
        android:id="@+id/btnLeave"
        android:layout_width="143dp"
        android:layout_height="31dp"
        android:alpha="1"
        android:background="@drawable/transparent_button_bg"
        android:textColor="#FFFFFF"
        android:stateListAnimator="@null"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.824"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.26" />

    <Button
        android:id="@+id/btnReady"
        android:layout_width="146dp"
        android:layout_height="35dp"
        android:alpha="1"
        android:background="@drawable/transparent_button_bg"
        android:textColor="#FFFFFF"
        android:stateListAnimator="@null"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.107"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.262" />

    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="141dp"
        android:layout_height="38dp"
        android:alpha="1"
        android:background="@drawable/transparent_button_bg"
        android:textColor="#FFFFFF"
        android:stateListAnimator="@null"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.469"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.262" />

    <ImageButton
        android:id="@+id/btnPrev"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_previous"
        android:backgroundTint="#66FFFFFF"
        android:alpha="0.7"
        app:layout_constraintBottom_toBottomOf="@id/imgMyCharacter"
        app:layout_constraintTop_toTopOf="@id/imgMyCharacter"
        app:layout_constraintEnd_toStartOf="@id/imgMyCharacter" />

    <ImageView
        android:id="@+id/imgMyCharacter"
        android:layout_width="120dp"
        android:layout_height="180dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.908"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.792" />

    <ImageView
        android:id="@+id/imgOtherPlayerCharacter2"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.633"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imgOtherPlayerCharacter3"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.366"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/imgOtherPlayerCharacter4"
        android:layout_width="120dp"
        android:layout_height="180dp"
        android:layout_marginBottom="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.101"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_media_next"
        android:backgroundTint="#66FFFFFF"
        android:alpha="0.7"
        app:layout_constraintBottom_toBottomOf="@id/imgMyCharacter"
        app:layout_constraintTop_toTopOf="@id/imgMyCharacter"
        app:layout_constraintStart_toEndOf="@id/imgMyCharacter" />

    <ImageView
        android:id="@+id/imgReadyCheck"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@android:drawable/checkbox_on_background"
        android:backgroundTint="#00CC00"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/imgMyCharacter"
        app:layout_constraintTop_toTopOf="@id/imgMyCharacter"
        app:layout_constraintStart_toStartOf="@id/imgMyCharacter"
        app:layout_constraintEnd_toEndOf="@id/imgMyCharacter" />

</androidx.constraintlayout.widget.ConstraintLayout>

